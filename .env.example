# Copy to .env and fill in. `make check-env` validates the required values.

# ─── LocalStack ─────────────────────────────────────────────────────────────
# Auth token from https://app.localstack.cloud. App emulators require Pro.
LOCALSTACK_AUTH_TOKEN=

# Set to 1 for verbose LocalStack logs.
DEBUG=0

# ─── Nango (self-hosted) ───────────────────────────────────────────────────
# 32-byte base64 key. Generate one with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# Where the CLI and scripts reach the local Nango server.
NANGO_HOSTPORT=http://localhost:3003

# Secret key for the local Nango environment. After the first `make up` you can
# copy the real one from the dashboard at http://localhost:3003. This default
# lets `make bootstrap` run unattended against a fresh local server.
NANGO_SECRET_KEY=nango-demo-secret-key
